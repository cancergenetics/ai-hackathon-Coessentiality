/datasets/**
!/datasets/**/
!/datasets/**/README.md
/data_cache/
/data/
*.parquet
*.npy
*.npz
*.h5
*.feather

# environments, caches, OS
.env/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
scratch/
.DS_Store

# local build / scoring outputs
manuscript/*.built.md
outputs/
